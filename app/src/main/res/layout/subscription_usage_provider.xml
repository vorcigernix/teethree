<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="vertical">
    <TextView android:id="@+id/widget_provider_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_foreground" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/widget_provider_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_secondary" android:textSize="11sp" android:maxLines="1" />
    <LinearLayout android:id="@+id/widget_windows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    <TextView android:id="@+id/widget_provider_extra" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_secondary" android:textSize="10sp" android:visibility="gone" android:maxLines="1" />
</LinearLayout>
