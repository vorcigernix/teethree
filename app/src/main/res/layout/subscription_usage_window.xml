<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical">
    <TextView android:id="@+id/widget_window_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_foreground" android:textSize="11sp" android:maxLines="1" />
    <ProgressBar android:id="@+id/widget_window_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:indeterminate="false" android:progressTint="@color/widget_accent" android:progressBackgroundTint="@color/widget_track" />
    <TextView android:id="@+id/widget_window_reset" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_secondary" android:textSize="10sp" android:maxLines="1" />
</LinearLayout>
